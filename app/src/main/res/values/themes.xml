<resources>
    <style name="Theme.OrionTv" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="browseTitleTextStyle">@style/Theme.OrionTv.BrowseTitle</item>
    </style>

    <style name="Theme.OrionTv.BrowseTitle" parent="Widget.Leanback.Title.Text">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="PlayerControlButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:background">@drawable/bg_focusable</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">96dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
